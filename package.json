{
  "name": "temix",
  "productName": "Temix",
  "version": "1.0.0",
  "description": "Temix robot controller",
  "author": "Temix",
  "main": "electron-main.js",
  "private": true,
  "scripts": {
    "prepare-web": "node prepare-web.js"
  },
  "devDependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/cli": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "electron": "^37.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.temix.app",
    "productName": "Temix",
    "directories": { "output": "dist" },
    "files": ["electron-main.js", "www/**", "package.json"],
    "win": {
      "target": ["nsis", "portable"],
      "icon": "www/icon-512.png"
    },
    "nsis": {
      "oneClick": true,
      "artifactName": "Temix-Setup.exe"
    },
    "portable": {
      "artifactName": "Temix-Portable.exe"
    }
  }
}
